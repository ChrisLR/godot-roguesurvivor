## res://assets/Sfx/<file>.ogg (only the OGGs are shipped, without
## extension in the constants).


const PATH := "res://assets/Sfx/"


const UNDEAD_EAT := "undead eat"
const UNDEAD_EAT_FILE := PATH + "sfx - undead eat.ogg"

const UNDEAD_RISE := "undead rise"
const UNDEAD_RISE_FILE := PATH + "sfx - undead rise.ogg"

const NIGHTMARE := "nightmare"
const NIGHTMARE_FILE := PATH + "sfx - nightmare.ogg"
